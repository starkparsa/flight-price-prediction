# Copy this file to `.env` and fill in your own values. `.env` is
# gitignored — never commit real credentials.

# Free signup: https://developers.amadeus.com -> My Self-Service Workspace -> Create New App
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# "production" for real current prices (2,000 free calls/month, guarded by
# quota_tracker.py); "test" for Amadeus's free/unlimited but narrower-coverage
# test data collection, useful for developing this script without touching
# the production quota.
AMADEUS_ENV=production
